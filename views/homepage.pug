doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="/css/style.css")

  body
    .container
      header.header
        h1 Games Directory
        a.btn.btn-primary(href="/update-cobj") + Add Game

      main.main-content
        if error
          .alert.alert-error= error

        //- Check if 'data' (the games list) exists and has items
        if data && data.length
          .cards
            each game in data
              article.card
                .card__id ID: #[strong= game.id]
                h3.card__name= game.properties.name || 'Untitled Game'
                
                p.card__detail
                  strong Publisher:
                  |  #{game.properties.publisher || '—'}
                
                p.card__detail
                  strong Price:
                  //- Formatting price with a $ sign
                  |  #{game.properties.price ? '$' + game.properties.price : '—'}

        else
          .empty-state
            p No games in the collection yet.
            a.btn.btn-secondary(href="/update-cobj") Add Your First Game